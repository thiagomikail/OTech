# Dependencies
node_modules/

# Build output
dist/
# `tsc -b` emits these next to the config (tsconfig.node.json has no noEmit); Vite would load a stale vite.config.js first
*.tsbuildinfo
vite.config.js
vite.config.d.ts

# Environment variables (contains API keys)
.env
.env.local
.env.*.local

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Temp files
.tmp_xlsx/
.venv/

# Data files (large, not needed for runtime)
*.xlsx
